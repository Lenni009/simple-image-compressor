    "images",
    "frontend"
  ],
  "author": "Lenni",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Lenni009/simple-image-compressor/issues"
  },
  "homepage": "https://lenni009.github.io/simple-image-compressor/",
  "devDependencies": {
    "@vitest/browser": "^4.1.0",
    "@vitest/browser-webdriverio": "^4.1.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.55.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
